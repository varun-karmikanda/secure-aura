# Database Configuration
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_strong_db_password
POSTGRES_DB=your_database_name
DATABASE_URL=postgresql://your_db_user:your_strong_db_password@postgres:5432/your_database_name

# Redis Configuration
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://:your_redis_password@redis:6379/0

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# Application Configuration
ENVIRONMENT=production
LOG_LEVEL=info

# Security Configuration (Timing Attack Defense)
MIN_NOISE_MS=50
MAX_NOISE_MS=200
CONSTANT_TIME_DELAY_MS=100

# Detection Configuration
DETECTION_THRESHOLD=0.75
ANALYSIS_WINDOW=300
MAX_REQUESTS_PER_MINUTE=60

# Dashboard Configuration (Update with your domain)
REACT_APP_AUTH_API_URL=http://localhost:8000
REACT_APP_MONITOR_API_URL=http://localhost:8001
